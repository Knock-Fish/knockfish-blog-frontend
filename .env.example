# =========================================================
# 环境变量示例（可提交到 git；真实配置写 .env / .env.development / .env.production 或 .env.local，均已被 .gitignore 忽略）
# 复制为 .env.local 后按需修改，不要提交真实地址与密钥
# =========================================================

# 【通用】
# 版本号
VITE_VERSION = 0.0.1
# 开发服务器端口
VITE_PORT = 5173
# 网站部署前缀（子路径部署时填写，如 /knockfish-blog/）
VITE_BASE_URL = /

# 【后端接口】
# 开发环境示例：http://localhost:8081；生产同域部署写 /
VITE_API_URL = http://localhost:8081

# 【首页音乐播放器】
# 网易云歌单 id：music.163.com/playlist?id=<这里> 的那串数字
# 留空则播放器只用 public/music 下的本地音频
VITE_MUSIC_PLAYLIST_ID =
# Meting 解析接口地址（公共实例随时可能失效，可换自建地址）
VITE_METING_API = https://api.injahow.cn/meting/
